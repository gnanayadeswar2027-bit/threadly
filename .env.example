# Set a long random value before hosting. Local demo uses a development-only fallback.
AUTH_SECRET=
# Supabase: Dashboard > project jiikixgbkzbysdbfspbt > Connect > Transaction pooler.
# Replace the password placeholder in the copied URI and append ?sslmode=require.
# Set only in a private local .env.local or the hosting provider's environment settings.
# Without it, local PGlite stores data in .threadly-data/.
DATABASE_URL=
# Optional: enables live AI draft generation.
OPENAI_API_KEY=
# Optional: Google sign-in for real accounts.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: allow the shared sample account in a hosted demo. Do not use for private customer data.
ALLOW_DEMO_LOGIN=false
