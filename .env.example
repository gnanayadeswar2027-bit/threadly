# Set a long random value before hosting. Local demo uses a development-only fallback.
AUTH_SECRET=
# Supabase server-only connection for the least-privilege `threadly_app` role.
# That role is NOLOGIN until private hosting credentials are configured; never use `postgres` here.
# Set only in private hosting environment settings; do not commit the URI.
# Without it, local PGlite stores data in .threadly-data/.
DATABASE_URL=
# Optional: enables live AI draft generation.
OPENAI_API_KEY=
# Optional: Google sign-in for real accounts.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: allow the shared sample account in a hosted demo. Do not use for private customer data.
ALLOW_DEMO_LOGIN=false
# X Developer Console app bearer token for read-only recent search.
X_BEARER_TOKEN=

# Server-only Apify token for real X discovery
APIFY_TOKEN=
